@{
    ViewBag.PageTitle = "Cart";
    ViewBag.CardTitle = "View Cart";
    Layout = "~/Views/Shared/_Customer.cshtml";
}
@model CartViewModel

	<br />
	<div class="card shadow border-0">
		<div class="card-header bg-primary bg-gradient text-white ml-0 py-4">
			<div class="row px-4">
				<div class="col-6">
					<h5 class="pt-2 text-white">
						Cart
					</h5>
				</div>

			</div>
		</div>
		<div class="card-body my-4">
			<div class="row">
			</div>
			<div class="row mb-3 pb-3">
				<div class="col-md-2 offset-md-1">
					<a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary text-uppercase mb-5 btn-sm"><small>Continue Shopping</small></a>
				</div>
				<div class="col-md-10 offset-md-1">
					@foreach (var item in Model.CartList)
					{
						<div class="row border-bottom pb-3">
							<div class="d-none d-lg-block col-lg-1 text-center py-2">
								@if (item.ImageUrl != null)
								{
									<img src="~/@item.ImageUrl" class="card-img-top rounded w-100">
								}
								else
								{
									<img src="https://placehold.co/500x600/png" class="card-img-top rounded w-100">
								}
							</div>
							<div class="col-12 col-lg-6 pt-md-3">
								<h5 class="text-uppercase text-white"><strong>@item.ProductName</strong></h5>
							</div>
							<div class="col-12  col-lg-5 text-center row">
								<div class="col-3 text-md-right pt-2 pt-md-4">
									<h6 class="fw-semibold">
										@item.Price.ToString("c")
										<span class="text-muted">&nbsp;x&nbsp;</span>@item.Quantity
									</h6>
								</div>
								<div class="col-6 col-sm-4 col-lg-6 pt-2">
									<div class="w-75 btn-group" role="group">
										<form asp-action="Plus" asp-route-productId="@item.ProductId" method="post" class="d-inline">
											<button type="submit" class="btn btn-outline-primary bg-gradient py-2">
												<i class="bi bi-plus-square"></i>
											</button>
										</form>
										&nbsp;
										<form asp-action="Minus" asp-route-productId="@item.ProductId" method="post" class="d-inline">
											<button type="submit" class="btn btn-outline-primary bg-gradient py-2">
												<i class="bi bi-dash-square"></i>
											</button>
										</form>
									</div>

								</div>
								<div class="col-3 col-sm-4 col-lg-2 offset-lg-1 text-right pt-2">
									<form asp-action="Remove" asp-route-productId="@item.ProductId" method="post" class="d-inline">
										<button type="submit" class="btn btn-danger bg-gradient py-2">
											<i class="bi bi-trash-fill"></i>
										</button>
									</form>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
			<div class="card-footer bg-white border-0">
				<div class="row">
					<div class="col-md-4 offset-md-4">
						<ul class="list-group mb-4">
							<li class="d-flex justify-content-between align-items-center">
								<h5 class="text-dark fw-semibold text-uppercase"> Total</h5>
								<h4 class="text-dark fw-bolder">@Model.CartList.Sum(x => x.Price * x.Quantity).ToString("c")</h4>
							</li>
						</ul>
					</div>
				</div>
				<div class="row">
					<div class="col-md-2 offset-md-5">
						<form asp-controller="Cart" asp-action="Clear" method="post" class="w-100">
							<button type="submit" class="btn btn-danger border-0 bg-gradient w-100 py-2">ClearCart</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>